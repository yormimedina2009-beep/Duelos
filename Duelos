local GAME_KEYWORDS = {"Map", "Game", "Arena", "Round", "Match", "Field", "Duel"}

local function isInGame()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return false
    end
    for _, obj in pairs(workspace:GetChildren()) do
        local name = obj.Name
        for _, keyword in pairs(GAME_KEYWORDS) do
            if string.find(name, keyword, 1, true) then
                return true
            end
        end
    end
    return false
end

local cachedInGame = true
task.spawn(function()
    while task.wait(1) do
        cachedInGame = isInGame()
    end
end)

