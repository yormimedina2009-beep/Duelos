-- ============================================
-- CÁLCULO DEL TARGET (CADA FRAME)
-- ============================================
local function updateTarget()
    if not silentAimEnabled then
        cachedTarget = nil
        cachedTargetPos = nil
        return
    end
    
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local myChar = player.Character
    local closest = nil
    local closestPos = nil
    local shortestDist = aimFOV
    
    for _, plr in pairs(Players:GetPlayers()) do
        if plr == player then continue end
        local char = plr.Character
        if not char then continue end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end
        if aimTeamCheck and myChar and plr.Team == player.Team then continue end
        
        local targetPart = char:FindFirstChild(aimPart)
                        or char:FindFirstChild("HumanoidRootPart")
        if not targetPart then continue end
        
        local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end
        
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist > shortestDist then continue end
        
        if aimWallCheck and myChar then
            local myHead = myChar:FindFirstChild("Head")
            if myHead then
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = {myChar, char}
                local result = workspace:Raycast(myHead.Position,
                    targetPart.Position - myHead.Position, rayParams)
                if result then continue end
            end
        end
        
        shortestDist = dist
        closest = plr
        closestPos = targetPart.Position
    end
    
    cachedTarget = closest
    cachedTargetPos = closestPos
end

RunService.RenderStepped:Connect(updateTarget)

-- ============================================
-- HOOK DEL MOUSE (REDIRIGE LA MIRA)
-- ============================================
local mouse = player:GetMouse()

local oldIndex
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if silentAimEnabled and cachedTargetPos then
        if self == mouse and key == "UnitRay" then
            local origin = camera.CFrame.Position
            local direction = (cachedTargetPos - origin).Unit
            return Ray.new(origin, direction)
        end
        
        if self == mouse and key == "Hit" then
            return CFrame.new(cachedTargetPos)
        end
        
        if self == mouse and key == "Target" then
            if cachedTarget and cachedTarget.Character then
                return cachedTarget.Character
            end
        end
    end
    return oldIndex(self, key)
end))

-- ============================================
-- HOOK DE ViewportPointToRay (POR SI EL ARMA LO USA)
-- ============================================
local oldViewportPointToRay = camera.ViewportPointToRay
camera.ViewportPointToRay = newcclosure(function(self, x, y, ...)
    if silentAimEnabled and cachedTargetPos then
        local origin = self.CFrame.Position
        local direction = (cachedTargetPos - origin).Unit
        return Ray.new(origin, direction)
    end
    return oldViewportPointToRay(self, x, y, ...)
end)

